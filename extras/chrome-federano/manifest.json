{
  "manifest_version": 3,
  "name": "Federano",
  "version": "0.3.0",
  "description": "Ajuda o Federano (no seu PC) a espelhar no tablet só o vídeo que está tocando, e a abrir vídeos do YouTube no tablet.",
  "host_permissions": [
    "http://127.0.0.1:8775/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
